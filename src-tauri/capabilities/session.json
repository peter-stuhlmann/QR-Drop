{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "session",
  "description": "Share- und Empfangsfenster (Label share-<id>): nur die Befehle für die eigene Sitzung.",
  "windows": ["share-*"],
  "permissions": [
    "allow-get-share",
    "allow-select-network",
    "allow-renew-share",
    "allow-cancel-share",
    "allow-reveal-received"
  ]
}
